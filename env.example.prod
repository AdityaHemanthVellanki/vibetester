NODE_ENV=production
ALLOW_ANON=false

# Fully managed Redis (ElastiCache or Upstash)
REDIS_URL=rediss://:PRODUCTION_REDIS_PASSWORD@redis-primary.cluster-abcd1234.use1.cache.amazonaws.com:6379

# Production database (RDS)
DATABASE_URL=postgresql://USERNAME:PASSWORD@rds-endpoint:5432/ai_test_architect

# Cloudflare R2
S3_PROVIDER=cloudflare
S3_BUCKET=production-bucket
S3_REGION=auto
S3_ACCESS_KEY_ID=${CLOUDFLARE_R2_ACCESS_KEY_ID}
S3_SECRET_ACCESS_KEY=${CLOUDFLARE_R2_SECRET_KEY}
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_FORCE_PATH_STYLE=true

# Auth
GITHUB_OAUTH_CLIENT_ID=${GITHUB_CLIENT_ID}
GITHUB_OAUTH_CLIENT_SECRET=${GITHUB_CLIENT_SECRET}
NEXTAUTH_URL=https://yourdomain.com
NEXTAUTH_SECRET=${NEXTAUTH_SECRET}
JWT_SECRET=${JWT_SECRET}

# AI Keys
OPENAI_API_KEY=${OPENAI_API_KEY}
LLM_MODEL=gpt-4o

# API Key hashing
API_KEY_SALT=${API_KEY_SALT}

# Observability
SENTRY_DSN=${SENTRY_DSN}
PROMETHEUS_PUSHGATEWAY=${PUSHGATEWAY_URL}
